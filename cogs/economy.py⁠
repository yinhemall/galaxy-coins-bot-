import discord
from discord import app_commands, ui, ButtonStyle
from discord.ext import commands
import sqlite3

# --- 簽到按鈕邏輯 ---
class CheckinView(ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @ui.button(label="領取每日銀河幣", style=ButtonStyle.green, emoji="🌕")
    async def checkin_button(self, interaction: discord.Interaction, button: ui.Button):
        # 這裡之後可以加入 SQLite 寫入簽到紀錄的邏輯
        await interaction.response.send_message(f"{interaction.user.name} 領取成功！", ephemeral=True)

class Economy(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    # 1. 每日簽到指令 (斜線指令)
    @app_commands.command(name="簽到", description="每天領取銀河幣")
    async def checkin(self, interaction: discord.Interaction):
        embed = discord.Embed(
            title="🌕 每日簽到",
            description="每天點擊下方按鈕領取 100~300 銀河幣 🌕\n\n"
                        "🎁 連續簽到滿 7 天，額外獲得 1,000 銀河幣\n"
                        "⏳ 24 小時冷卻，每人每天只能領一次",
            color=0xF1C40F
        )
        embed.set_footer(text="銀河商城 · 每日簽到系統")
        await interaction.response.send_message(embed=embed, view=CheckinView())

    # 2. 錢包指令
    @app_commands.command(name="balance", description="查看你的錢包餘額")
    async def balance(self, interaction: discord.Interaction):
        # 這裡之後從資料庫讀取餘額
        await interaction.response.send_message(f"你目前的餘額是：0 銀河幣", ephemeral=True)

    # 3. 轉帳指令
    @app_commands.command(name="轉帳", description="轉帳給其他使用者")
    async def transfer(self, interaction: discord.Interaction, target: discord.Member, amount: int):
        if amount <= 0:
            await interaction.response.send_message("轉帳金額必須大於 0！", ephemeral=True)
            return
        await interaction.response.send_message(f"成功轉帳 {amount} 給 {target.mention}")

    # 4. 排行榜指令
    @app_commands.command(name="排行榜", description="查看富豪排行榜")
    async def leaderboard(self, interaction: discord.Interaction):
        await interaction.response.send_message("目前排行榜還在建置中喔！")

async def setup(bot):
    await bot.add_cog(Economy(bot))
